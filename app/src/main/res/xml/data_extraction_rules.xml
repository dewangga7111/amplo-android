<?xml version="1.0" encoding="utf-8"?>
<!-- The Spotify login stays on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/spotify.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/spotify.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
